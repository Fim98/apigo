meta {
  name: users-api
  type: collection
  version: 1.0.0
}

headers {
  @description('''Sent with every request''')
  X-Client: apigo
}

vars:pre-request {
  baseUrl: https://api.example.com
}

vars:post-response {
  userId: res.body.id
}

tests {
  test('collection smoke', function() {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Collection notes.
}
